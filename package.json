{
  "name": "openapi-bundle",
  "displayName": "OpenAPI Bundle",
  "description": "Extensión para generar el bundle del contrato OpenAPI incluyendo los schemas referenciados.",
  "version": "0.0.1",
  "publisher": "PedroAguilar",

  "engines": {
    "vscode": "^1.75.0"
  },

  "categories": ["Other"],

  "activationEvents": [],

  "main": "./out/extension.js",

  "contributes": {
    "commands": [
      {
        "command": "openapi-bundle-schema.bundle",
        "title": "OpenAPI: Bundlear contrato con schemas"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "openapi-bundle-schema.bundle",
          "when": "resourceExtname == .yaml",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "openapi-bundle-schema.bundle",
          "when": "resourceExtname == .yaml",
          "group": "navigation"
        }
      ]
    }
  },

  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src",
    "test": "node ./out/test/runTest.js"
  },

  "devDependencies": {
    "@types/vscode": "1.75.0",
    "@types/node": "18.x",
    "@types/mocha": "^10.0.10",
    "typescript": "^5.3.0",
    "eslint": "^8.56.0",
    "@vscode/test-electron": "^2.5.2"
  },

  "dependencies": {
    "@redocly/openapi-core": "^2.11.1",
    "js-yaml": "^4.1.0"
  }
}
